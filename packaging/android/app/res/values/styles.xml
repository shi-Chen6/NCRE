<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 无 ActionBar 全屏：整屏交给 WebView；颜色与页面顶栏对齐 -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
    </style>
</resources>
